# Copy to .env and set the public origin of this site.
# The production build sets this from the Cloudflare Workers Builds build variable;
# it is never committed, so the repository carries no live domain.
SITE_URL=https://example.com

# Commercial-licence mailbox. Served to the page by `GET /api/site`; leave it empty
# and the contact blocks stay hidden. In production this is a Worker variable
# (Cloudflare dashboard → Settings → Variables) or a local `.dev.vars` entry.
CONTACT_EMAIL=
